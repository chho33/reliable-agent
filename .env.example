# Copy to .env (never commit .env). Model specs are "<provider>:<model-id>".
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# e.g. AGENT_MODEL=anthropic:claude-sonnet-5-5   or   AGENT_MODEL=openai:<model-id>
AGENT_MODEL=
USER_MODEL=
# Optional: base URL for OpenAI-compatible servers (vLLM, Ollama, OpenRouter, ...)
# OPENAI_BASE_URL=http://localhost:11434/v1
